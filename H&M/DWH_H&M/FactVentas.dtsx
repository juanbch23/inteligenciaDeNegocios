                  dataType="System.String"
                  description="Especifica la instrucción SQL que genera la tabla de búsqueda."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT f.[FechaKey], t.[TemporadaKey]
  FROM [GENERICO].[DimFecha] f
 CROSS APPLY (SELECT TOP (1) d.[TemporadaKey] FROM [Ventas].[DimTemporada] d
               WHERE d.[TemporadaKey] &gt; 0 AND f.[Fecha] BETWEEN d.[FechaInicio] AND d.[FechaFin]
               ORDER BY d.[FechaFin]) t
 WHERE f.[FechaKey] &gt; 0</property>
