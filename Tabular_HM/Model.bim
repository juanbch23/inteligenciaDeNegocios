{
  "name": "SemanticModel",
  "compatibilityLevel": 1200,
  "model": {
    "culture": "es-ES",
    "dataSources": [
      {
        "name": "DWH_HM",
        "connectionString": "Provider=MSOLEDBSQL.1;Data Source=LAPTOP-IO596P6A\\DEV;Initial Catalog=DWH_HM;Integrated Security=SSPI;Persist Security Info=false",
        "impersonationMode": "impersonateServiceAccount",
        "annotations": [
          {
            "name": "ConnectionEditUISource",
            "value": "SqlServer"
          }
        ]
      }
    ],
    "tables": [
      {
        "name": "DimFecha",
        "columns": [
          {
            "name": "FechaKey",
            "dataType": "int64",
            "sourceColumn": "FechaKey",
            "isHidden": true
          },
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "formatString": "dd/MM/yyyy",
            "isKey": true
          },
          {
            "name": "Dia_Semana",
            "dataType": "int64",
            "sourceColumn": "Dia_Semana",
            "isHidden": true
          },
          {
            "name": "Nombre_Dia_Semana",
            "dataType": "string",
            "sourceColumn": "Nombre_Dia_Semana",
            "sortByColumn": "Dia_Semana"
          },
          {
            "name": "Dia_Mes",
            "dataType": "int64",
            "sourceColumn": "Dia_Mes"
          },
          {
            "name": "Dia_Anio",
            "dataType": "int64",
            "sourceColumn": "Dia_Anio"
          },
          {
            "name": "Nombre_Mes",
            "dataType": "string",
            "sourceColumn": "Nombre_Mes",
            "sortByColumn": "Mes_Anio"
          },
          {
            "name": "Mes_Anio",
            "dataType": "int64",
            "sourceColumn": "Mes_Anio"
          },
          {
            "name": "Semana_Anio",
            "dataType": "int64",
            "sourceColumn": "Semana_Anio"
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio",
            "formatString": "0"
          },
          {
            "name": "Bimestre",
            "dataType": "int64",
            "sourceColumn": "Bimestre"
          },
          {
            "name": "Trimestre",
            "dataType": "int64",
            "sourceColumn": "Trimestre"
          },
          {
            "name": "Cuatrimestre",
            "dataType": "int64",
            "sourceColumn": "Cuatrimestre"
          },
          {
            "name": "Semestre",
            "dataType": "int64",
            "sourceColumn": "Semestre"
          },
          {
            "name": "Fin_Semana",
            "dataType": "int64",
            "sourceColumn": "Fin_Semana",
            "description": "1 = sábado o domingo"
          },
          {
            "name": "AnioMes",
            "dataType": "int64",
            "sourceColumn": "AnioMes",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "Periodo",
            "dataType": "string",
            "sourceColumn": "Periodo",
            "sortByColumn": "AnioMes",
            "description": "Mes-Año (Sep-2018); se ordena cronológicamente"
          }
        ],
        "partitions": [
          {
            "name": "DimFecha",
            "dataView": "full",
            "source": {
              "query": "SELECT [FechaKey], CAST([Fecha] AS DATETIME) AS [Fecha], [Dia_Semana], CASE [Dia_Semana] WHEN 1 THEN 'Domingo' WHEN 2 THEN 'Lunes' WHEN 3 THEN 'Martes' WHEN 4 THEN 'Miércoles' WHEN 5 THEN 'Jueves' WHEN 6 THEN 'Viernes' ELSE 'Sábado' END AS [Nombre_Dia_Semana],\n       [Dia_Mes], [Dia_Anio], CASE [Mes_Anio] WHEN 1 THEN 'Enero' WHEN 2 THEN 'Febrero' WHEN 3 THEN 'Marzo' WHEN 4 THEN 'Abril' WHEN 5 THEN 'Mayo' WHEN 6 THEN 'Junio' WHEN 7 THEN 'Julio' WHEN 8 THEN 'Agosto' WHEN 9 THEN 'Septiembre' WHEN 10 THEN 'Octubre' WHEN 11 THEN 'Noviembre' ELSE 'Diciembre' END AS [Nombre_Mes], [Mes_Anio], [Semana_Anio], [Anio], [Bimestre],\n       [Trimestre], [Cuatrimestre], [Semestre], [Fin_Semana], [AnioMes],\n       LEFT(CASE [Mes_Anio] WHEN 1 THEN 'Enero' WHEN 2 THEN 'Febrero' WHEN 3 THEN 'Marzo' WHEN 4 THEN 'Abril' WHEN 5 THEN 'Mayo' WHEN 6 THEN 'Junio' WHEN 7 THEN 'Julio' WHEN 8 THEN 'Agosto' WHEN 9 THEN 'Septiembre' WHEN 10 THEN 'Octubre' WHEN 11 THEN 'Noviembre' ELSE 'Diciembre' END, 3) + '-' + CAST([Anio] AS VARCHAR(4)) AS [Periodo]\n  FROM [GENERICO].[DimFecha] WHERE [FechaKey] > 0",
              "dataSource": "DWH_HM"
            }
          }
        ],
        "dataCategory": "Time",
        "measures": [
          {
            "name": ".Anio_Actual",
            "expression": "MAX(DimFecha[Anio])",
            "formatString": "0",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Anio_Elegido",
            "expression": "IF(HASONEVALUE(DimFecha[Anio]), VALUES(DimFecha[Anio]))",
            "formatString": "0",
            "displayFolder": "2. Tiempo",
            "description": "Año elegido en el filtro (vacío si se ven todos los años)"
          },
          {
            "name": ".Anio_Comparacion",
            "expression": "VAR a = [.Anio_Elegido]\nVAR c = SELECTEDVALUE(AnioComparacion[Comparar con])\nRETURN\n    IF(ISBLANK(a), BLANK(), IF(ISBLANK(c), a - 1, c))",
            "formatString": "0",
            "displayFolder": "2. Tiempo",
            "description": "Año contra el que se compara: el del filtro Comparar con, o el anterior al elegido"
          },
          {
            "name": ".Desfase_Meses",
            "expression": "IF(ISBLANK([.Anio_Elegido]), BLANK(), 12 * ([.Anio_Elegido] - [.Anio_Comparacion]))",
            "formatString": "0",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Txt_Comparacion",
            "expression": "IF(ISBLANK([.Anio_Comparacion]), BLANK(),\n   \"vs \" & [.Anio_Comparacion] & IF([.Comparacion_Incompleta], \" (año con datos incompletos)\"))",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Txt_Comparacion_Tarjeta",
            "expression": "IF(ISBLANK([.Txt_Comparacion]), \"Elige un año para ver la variación\", [.Txt_Comparacion])",
            "displayFolder": "7. Dashboards"
          }
        ]
      },
      {
        "name": "DimTemporada",
        "columns": [
          {
            "name": "TemporadaKey",
            "dataType": "int64",
            "sourceColumn": "TemporadaKey",
            "isHidden": true
          },
          {
            "name": "TemporadaID",
            "dataType": "int64",
            "sourceColumn": "TemporadaID",
            "isHidden": true
          },
          {
            "name": "Temporada",
            "dataType": "string",
            "sourceColumn": "Temporada",
            "sortByColumn": "TemporadaID"
          },
          {
            "name": "Estacion",
            "dataType": "string",
            "sourceColumn": "Estacion",
            "sortByColumn": "OrdenEstacion"
          },
          {
            "name": "OrdenEstacion",
            "dataType": "int64",
            "sourceColumn": "OrdenEstacion",
            "isHidden": true
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio",
            "formatString": "0"
          },
          {
            "name": "FechaInicio",
            "dataType": "dateTime",
            "sourceColumn": "FechaInicio",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "FechaFin",
            "dataType": "dateTime",
            "sourceColumn": "FechaFin",
            "formatString": "dd/MM/yyyy"
          }
        ],
        "partitions": [
          {
            "name": "DimTemporada",
            "dataView": "full",
            "source": {
              "query": "SELECT [TemporadaKey], [TemporadaID], [Temporada], [Estacion], [Anio], CAST([FechaInicio] AS DATETIME) AS [FechaInicio],\n       CAST([FechaFin] AS DATETIME) AS [FechaFin],\n       CASE [Estacion] WHEN 'verano' THEN 1 WHEN 'otoño' THEN 2 WHEN 'invierno' THEN 3 WHEN 'primavera' THEN 4 ELSE 9 END\n           AS [OrdenEstacion]   -- orden del año comercial (hemisferio sur): verano, otoño, invierno, primavera\n  FROM [Ventas].[DimTemporada] WHERE [TemporadaKey] > 0",
              "dataSource": "DWH_HM"
            }
          }
        ]
      },
      {
        "name": "DimCanal",
        "columns": [
          {
            "name": "CanalKey",
            "dataType": "int64",
            "sourceColumn": "CanalKey",
            "isHidden": true
          },
          {
            "name": "CanalID",
            "dataType": "int64",
            "sourceColumn": "CanalID",
            "isHidden": true
          },
          {
            "name": "NombreCanal",
            "dataType": "string",
            "sourceColumn": "NombreCanal"
          }
        ],
        "partitions": [
          {
            "name": "DimCanal",
            "dataView": "full",
            "source": {
              "query": "SELECT [CanalKey], [CanalID], [NombreCanal] FROM [Ventas].[DimCanal] WHERE [CanalKey] > 0",
              "dataSource": "DWH_HM"
            }
          }
        ]
      },
      {
        "name": "DimDepartamento",
        "columns": [
          {
            "name": "DepartamentoKey",
            "dataType": "int64",
            "sourceColumn": "DepartamentoKey",
            "isHidden": true
          },
          {
            "name": "Departamento",
            "dataType": "string",
            "sourceColumn": "Departamento"
          },
          {
            "name": "Seccion",
            "dataType": "string",
            "sourceColumn": "Seccion"
          }
        ],
        "partitions": [
          {
            "name": "DimDepartamento",
            "dataView": "full",
            "source": {
              "query": "SELECT [DepartamentoKey], [department_name] AS [Departamento], [section_name] AS [Seccion]\n  FROM [Ventas].[DimDepartamento] WHERE [DepartamentoKey] > 0",
              "dataSource": "DWH_HM"
            }
          }
        ]
      },
      {
        "name": "DimArticulo",
        "columns": [
          {
            "name": "ArticuloKey",
            "dataType": "int64",
            "sourceColumn": "ArticuloKey",
            "isHidden": true
          },
          {
            "name": "ArticleID",
            "dataType": "int64",
            "sourceColumn": "ArticleID",
            "formatString": "0"
          },
          {
            "name": "Producto",
            "dataType": "string",
            "sourceColumn": "Producto"
          },
          {
            "name": "TipoProducto",
            "dataType": "string",
            "sourceColumn": "TipoProducto"
          },
          {
            "name": "GrupoProducto",
            "dataType": "string",
            "sourceColumn": "GrupoProducto"
          },
          {
            "name": "Apariencia",
            "dataType": "string",
            "sourceColumn": "Apariencia"
          },
          {
            "name": "Color",
            "dataType": "string",
            "sourceColumn": "Color"
          },
          {
            "name": "ColorMaestro",
            "dataType": "string",
            "sourceColumn": "ColorMaestro"
          },
          {
            "name": "Indice",
            "dataType": "string",
            "sourceColumn": "Indice"
          },
          {
            "name": "GrupoIndice",
            "dataType": "string",
            "sourceColumn": "GrupoIndice"
          },
          {
            "name": "GrupoPrenda",
            "dataType": "string",
            "sourceColumn": "GrupoPrenda"
          }
        ],
        "partitions": [
          {
            "name": "DimArticulo",
            "dataView": "full",
            "source": {
              "query": "SELECT [ArticuloKey], [ArticleID], [ProdName] AS [Producto], [ProductTypeName] AS [TipoProducto],\n       [ProductGroupName] AS [GrupoProducto], [GraphicalAppearanceName] AS [Apariencia],\n       [ColourGroupName] AS [Color], [PerceivedColourMasterName] AS [ColorMaestro],\n       [IndexName] AS [Indice], [IndexGroupName] AS [GrupoIndice], [GarmentGroupName] AS [GrupoPrenda]\n  FROM [Ventas].[DimArticulo] WHERE [ArticuloKey] > 0",
              "dataSource": "DWH_HM"
            }
          }
        ],
        "measures": [
          {
            "name": ".Titulo_Dinamico_GrupoIndice",
            "expression": "VAR grupo = DISTINCT(DimArticulo[GrupoIndice])\nVAR grupo_S = CONCATENATEX(grupo, DimArticulo[GrupoIndice], \" - \")\nVAR CANTIDAD = COUNTROWS(grupo)\nVAR TITULO = IF(CANTIDAD > 4, \"Pareto de ventas por sección (todos los grupos)\", \"Pareto de ventas por sección: \" & grupo_S)\nRETURN\n    TITULO",
            "displayFolder": "3. Pareto"
          }
        ]
      },
      {
        "name": "DimCliente",
        "columns": [
          {
            "name": "ClienteKey",
            "dataType": "int64",
            "sourceColumn": "ClienteKey",
            "isHidden": true
          },
          {
            "name": "FN",
            "dataType": "boolean",
            "sourceColumn": "FN"
          },
          {
            "name": "Active",
            "dataType": "boolean",
            "sourceColumn": "Active"
          },
          {
            "name": "EstadoClub",
            "dataType": "string",
            "sourceColumn": "EstadoClub"
          },
          {
            "name": "FrecuenciaNoticias",
            "dataType": "string",
            "sourceColumn": "FrecuenciaNoticias"
          },
          {
            "name": "Edad",
            "dataType": "int64",
            "sourceColumn": "Edad"
          },
          {
            "name": "RangoEdad",
            "dataType": "string",
            "sourceColumn": "RangoEdad"
          },
          {
            "name": "ClubActivo",
            "dataType": "string",
            "sourceColumn": "ClubActivo"
          },
          {
            "name": "FechaPrimeraCompra",
            "dataType": "dateTime",
            "sourceColumn": "FechaPrimeraCompra",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "MesesConCompra",
            "dataType": "int64",
            "sourceColumn": "MesesConCompra"
          },
          {
            "name": "TipoCanal",
            "dataType": "string",
            "sourceColumn": "TipoCanal",
            "description": "Omnicanal / Solo online / Solo tienda (todo el historial)"
          },
          {
            "name": "Compra2019",
            "dataType": "int64",
            "sourceColumn": "Compra2019",
            "isHidden": true
          },
          {
            "name": "Compra2020",
            "dataType": "int64",
            "sourceColumn": "Compra2020",
            "isHidden": true
          },
          {
            "name": "SegmentoValor",
            "dataType": "string",
            "sourceColumn": "SegmentoValor",
            "description": "Top 20 % / Siguiente 30 % / Resto 50 % de compradores por venta total"
          }
        ],
        "partitions": [
          {
            "name": "DimCliente",
            "dataView": "full",
            "source": {
              "query": "SELECT [ClienteKey], [FN], [Active], [ClubMemberStatus] AS [EstadoClub],\n       [FashionNewsFrequency] AS [FrecuenciaNoticias], [Edad], [RangoEdad], [ClubActivo],\n       [FechaPrimeraCompra], [MesesConCompra], [TipoCanal], [Compra2019], [Compra2020], [SegmentoValor]\n  FROM [Ventas].[vw_ClienteComportamiento]",
              "dataSource": "DWH_HM"
            }
          }
        ],
        "measures": [
          {
            "name": ".Clientes_Registrados",
            "expression": "COUNTROWS(DimCliente)",
            "formatString": "#,0",
            "displayFolder": "5. Clientes"
          },
          {
            "name": ".Edad_Promedio_Compradores",
            "expression": "CALCULATE(AVERAGE(DimCliente[Edad]), CROSSFILTER(FactVentas[ClienteKey], DimCliente[ClienteKey], BOTH))",
            "formatString": "0.0",
            "displayFolder": "5. Clientes",
            "description": "Edad promedio de los clientes que compraron en el contexto"
          },
          {
            "name": ".%Clientes_Compradores",
            "expression": "DIVIDE([.Clientes_Unicos], [.Clientes_Registrados])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "5. Clientes"
          },
          {
            "name": ".Clientes_Nuevos",
            "expression": "VAR d1 = MIN(DimFecha[Fecha])\nVAR d2 = MAX(DimFecha[Fecha])\nRETURN\n    CALCULATE(COUNTROWS(DimCliente), DimCliente[FechaPrimeraCompra] >= d1, DimCliente[FechaPrimeraCompra] <= d2)",
            "formatString": "#,0",
            "displayFolder": "6. Indicadores del caso\\Clientes",
            "description": "Clientes cuya primera compra cae en el periodo filtrado"
          },
          {
            "name": ".%Recompra",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(DimCliente), DimCliente[MesesConCompra] > 1),\n       CALCULATE(COUNTROWS(DimCliente), DimCliente[MesesConCompra] >= 1))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Clientes",
            "description": "Compradores con compra en más de un mes"
          },
          {
            "name": ".%Retencion_2019_2020",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(DimCliente), DimCliente[Compra2019] = 1, DimCliente[Compra2020] = 1),\n       CALCULATE(COUNTROWS(DimCliente), DimCliente[Compra2019] = 1))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Clientes",
            "description": "Compradores de 2019 que vuelven en 2020"
          },
          {
            "name": ".Color_Retencion",
            "expression": "VAR x = [.%Retencion_2019_2020]\nRETURN\n    SWITCH(TRUE(), ISBLANK(x), BLANK(), x >= 0.65, \"#1E8449\", x >= 0.65 - 0.05, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "6. Indicadores del caso\\Clientes",
            "description": "Meta propuesta >= 65 %"
          },
          {
            "name": ".Clientes_Nuevos_AA",
            "expression": "VAR k = [.Desfase_Meses]\nVAR d1 = EDATE(MIN(DimFecha[Fecha]), -k)\nVAR d2 = EDATE(MAX(DimFecha[Fecha]), -k)\nRETURN\n    IF(NOT ISBLANK(k) && k <> 0,\n       CALCULATE(COUNTROWS(DimCliente), DimCliente[FechaPrimeraCompra] >= d1, DimCliente[FechaPrimeraCompra] <= d2))",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Clientes nuevos de los mismos días del año de comparación"
          },
          {
            "name": ".Det_Nuevos",
            "expression": "IF(ISBLANK([.Clientes_Nuevos_AA]) || [.Clientes_Nuevos_AA] = 0, \"Elige un año para compararlo\", FORMAT(DIVIDE([.Clientes_Nuevos], [.Clientes_Nuevos_AA]) - 1, \"+0.0 %;-0.0 %\") & \" \" & [.Txt_Comparacion] & \" (\" & FORMAT([.Clientes_Nuevos_AA], \"#,0\") & \")\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Nuevos",
            "expression": "VAR r = DIVIDE([.Clientes_Nuevos], [.Clientes_Nuevos_AA])\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Nuevos_Resto",
            "expression": "IF(ISBLANK([.Anillo_Nuevos]), BLANK(), 1 - [.Anillo_Nuevos])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Nuevos",
            "expression": "VAR r = DIVIDE([.Clientes_Nuevos], [.Clientes_Nuevos_AA])\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          }
        ]
      },
      {
        "name": "FactVentas",
        "columns": [
          {
            "name": "FechaKey",
            "dataType": "int64",
            "sourceColumn": "FechaKey",
            "isHidden": true
          },
          {
            "name": "ClienteKey",
            "dataType": "int64",
            "sourceColumn": "ClienteKey",
            "isHidden": true
          },
          {
            "name": "ArticuloKey",
            "dataType": "int64",
            "sourceColumn": "ArticuloKey",
            "isHidden": true
          },
          {
            "name": "DepartamentoKey",
            "dataType": "int64",
            "sourceColumn": "DepartamentoKey",
            "isHidden": true
          },
          {
            "name": "CanalKey",
            "dataType": "int64",
            "sourceColumn": "CanalKey",
            "isHidden": true
          },
          {
            "name": "TemporadaKey",
            "dataType": "int64",
            "sourceColumn": "TemporadaKey",
            "isHidden": true
          },
          {
            "name": "Precio",
            "dataType": "double",
            "sourceColumn": "Precio",
            "isHidden": true,
            "formatString": "#,0.00"
          },
          {
            "name": "PrecioLista",
            "dataType": "double",
            "sourceColumn": "PrecioLista",
            "isHidden": true,
            "formatString": "#,0.00",
            "description": "Precio máximo observado del artículo"
          },
          {
            "name": "BandaDescuento",
            "dataType": "string",
            "sourceColumn": "BandaDescuento",
            "description": "Descuento de la línea frente al precio de lista"
          }
        ],
        "partitions": [
          {
            "name": "FactVentas",
            "dataView": "full",
            "source": {
              "query": "SELECT [FechaKey], [ClienteKey], [ArticuloKey], [DepartamentoKey], [CanalKey], [TemporadaKey], [Precio],\n       [PrecioLista], [BandaDescuento]\n  FROM [Ventas].[vw_FactVentasCubo]",
              "dataSource": "DWH_HM"
            }
          }
        ],
        "measures": [
          {
            "name": ".Ventas",
            "expression": "SUM(FactVentas[Precio])",
            "formatString": "#,0.00",
            "displayFolder": "1. Ventas",
            "description": "Suma del precio de cada artículo vendido"
          },
          {
            "name": ".Ticket_Promedio",
            "expression": "AVERAGE(FactVentas[Precio])",
            "formatString": "#,0.00",
            "displayFolder": "1. Ventas",
            "description": "Precio promedio por artículo vendido"
          },
          {
            "name": ".Transacciones",
            "expression": "COUNTROWS(FactVentas)",
            "formatString": "#,0",
            "displayFolder": "1. Ventas",
            "description": "Artículos vendidos (una fila por artículo)"
          },
          {
            "name": ".Clientes_Unicos",
            "expression": "DISTINCTCOUNT(FactVentas[ClienteKey])",
            "formatString": "#,0",
            "displayFolder": "1. Ventas"
          },
          {
            "name": ".Articulos_Distintos",
            "expression": "DISTINCTCOUNT(FactVentas[ArticuloKey])",
            "formatString": "#,0",
            "displayFolder": "1. Ventas"
          },
          {
            "name": ".Ventas_por_Cliente",
            "expression": "DIVIDE([.Ventas], [.Clientes_Unicos])",
            "formatString": "#,0.00",
            "displayFolder": "1. Ventas"
          },
          {
            "name": ".Articulos_por_Cliente",
            "expression": "DIVIDE([.Transacciones], [.Clientes_Unicos])",
            "formatString": "#,0.00",
            "displayFolder": "1. Ventas"
          },
          {
            "name": ".Ventas_Online",
            "expression": "CALCULATE([.Ventas], DimCanal[NombreCanal] = \"Online\")",
            "formatString": "#,0.00",
            "displayFolder": "1. Ventas"
          },
          {
            "name": ".Ventas_Tienda",
            "expression": "CALCULATE([.Ventas], DimCanal[NombreCanal] = \"Tienda fisica\")",
            "formatString": "#,0.00",
            "displayFolder": "1. Ventas"
          },
          {
            "name": ".%Ventas_Online",
            "expression": "DIVIDE([.Ventas_Online], [.Ventas])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "1. Ventas"
          },
          {
            "name": ".%Participacion",
            "expression": "DIVIDE([.Ventas], CALCULATE([.Ventas], ALLSELECTED()))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "1. Ventas",
            "description": "Participación sobre el total visible"
          },
          {
            "name": ".Acumulado_Anual",
            "expression": "TOTALYTD([.Ventas], DimFecha[Fecha])",
            "formatString": "#,0.00",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Ventas_Ultimos_Dias_7",
            "expression": "CALCULATE ( [.Ventas], DATESINPERIOD ( DimFecha[Fecha], MAX ( DimFecha[Fecha] ), -7, DAY ) )",
            "formatString": "#,0.00",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Ventas_Ultimos_Dias_7_avg",
            "expression": "AVERAGEX ( DATESINPERIOD ( DimFecha[Fecha], MAX ( DimFecha[Fecha] ), -7, DAY ), [.Ventas] )",
            "formatString": "#,0.00",
            "displayFolder": "2. Tiempo",
            "description": "Promedio diario de ventas de los últimos 7 días (media móvil)"
          },
          {
            "name": ".Comparacion_Incompleta",
            "expression": "VAR k = [.Desfase_Meses]\nVAR fechas = SELECTCOLUMNS(VALUES(DimFecha[Fecha]), \"F\", EDATE(DimFecha[Fecha], -k))\nVAR dias = DISTINCTCOUNT(FactVentas[FechaKey])\nVAR dias_comp = CALCULATE(DISTINCTCOUNT(FactVentas[FechaKey]), ALL(DimFecha), TREATAS(fechas, DimFecha[Fecha]))\nRETURN\n    IF(NOT ISBLANK(k) && k <> 0, dias_comp < dias * 0.9)",
            "displayFolder": "2. Tiempo",
            "description": "Verdadero si el año de comparación tiene menos de 90 % de los días con venta (datos incompletos)"
          },
          {
            "name": ".Ventas_Mismo_Periodo_AA",
            "expression": "VAR k = [.Desfase_Meses]\nVAR fechas = SELECTCOLUMNS(VALUES(DimFecha[Fecha]), \"F\", EDATE(DimFecha[Fecha], -k))\nRETURN\n    IF(NOT ISBLANK(k) && k <> 0,                        -- solo cuando se elige un año para comparar\n       CALCULATE([.Ventas], ALL(DimFecha), TREATAS(fechas, DimFecha[Fecha])))",
            "formatString": "#,0.00",
            "displayFolder": "2. Tiempo",
            "description": "Ventas de exactamente los mismos días (y meses filtrados) del año de comparación"
          },
          {
            "name": ".%Crecimiento_Interanual",
            "expression": "DIVIDE([.Ventas] - [.Ventas_Mismo_Periodo_AA], [.Ventas_Mismo_Periodo_AA])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Ventas_Anio_Actual",
            "expression": "VAR anio = [.Anio_Actual]\nRETURN\n    CALCULATE([.Ventas], ALL(DimFecha[Anio]), DimFecha[Anio] = anio)",
            "formatString": "#,0.00",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Ventas_Anio_prev-1",
            "expression": "VAR anio = [.Anio_Actual] - 1\nRETURN\n    CALCULATE([.Ventas], ALL(DimFecha[Anio]), DimFecha[Anio] = anio)",
            "formatString": "#,0.00",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Ventas_Anio_prev-2",
            "expression": "VAR anio = [.Anio_Actual] - 2\nRETURN\n    CALCULATE([.Ventas], ALL(DimFecha[Anio]), DimFecha[Anio] = anio)",
            "formatString": "#,0.00",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".%var_Ventas",
            "expression": "DIVIDE([.Ventas_Anio_Actual] - [.Ventas_Anio_prev-1], [.Ventas_Anio_prev-1])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".%Var_Ventas_I",
            "expression": "VAR si = IF([.%var_Ventas] < 0, \"▼\", \"▲\")\nRETURN\n    IF(ISBLANK([.%var_Ventas]), BLANK(), FORMAT([.%var_Ventas], \"0.00 %\") & \"  \" & si)",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Titulo_Varianza",
            "expression": "\"Año \" & [.Anio_Actual] & \" vs \" & ([.Anio_Actual] - 1)",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".%var_Ventas1",
            "expression": "DIVIDE([.Ventas_Anio_Actual] - [.Ventas_Anio_prev-2], [.Ventas_Anio_prev-2])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".%Var_Ventas1_I",
            "expression": "VAR si = IF([.%var_Ventas1] < 0, \"▼\", \"▲\")\nRETURN\n    IF(ISBLANK([.%var_Ventas1]), BLANK(), FORMAT([.%var_Ventas1], \"0.00 %\") & \"  \" & si)",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Titulo_Varianza1",
            "expression": "\"Año \" & [.Anio_Actual] & \" vs \" & ([.Anio_Actual] - 2)",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".Titulo_Comparacion_anual",
            "expression": "\"Comparación anual \" & [.Anio_Actual] & \" - \" & ([.Anio_Actual] - 1) & \" - \" & ([.Anio_Actual] - 2)",
            "displayFolder": "2. Tiempo"
          },
          {
            "name": ".%Pareto_Ventas_Departamento",
            "expression": "VAR A = [.Ventas]\nVAR B = CALCULATE([.Ventas], ALLSELECTED(DimDepartamento[Departamento]))\nVAR TOTAL =\n    DIVIDE(\n        SUMX(\n            FILTER(\n                SUMMARIZE(ALLSELECTED(DimDepartamento[Departamento]), DimDepartamento[Departamento], \"PORC\", [.Ventas]),\n                [PORC] >= A),\n            [PORC]),\n        B)\nRETURN\n    TOTAL",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "3. Pareto",
            "description": "Porcentaje acumulado de ventas (departamentos ordenados de mayor a menor)"
          },
          {
            "name": ".%Pareto_Ventas_Seccion",
            "expression": "VAR A = [.Ventas]\nVAR B = CALCULATE([.Ventas], ALLSELECTED(DimDepartamento[Seccion]))\nVAR TOTAL =\n    DIVIDE(\n        SUMX(\n            FILTER(\n                SUMMARIZE(ALLSELECTED(DimDepartamento[Seccion]), DimDepartamento[Seccion], \"PORC\", [.Ventas]),\n                [PORC] >= A),\n            [PORC]),\n        B)\nRETURN\n    TOTAL",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "3. Pareto",
            "description": "Porcentaje acumulado de ventas (secciones ordenadas de mayor a menor)"
          },
          {
            "name": ".Cestas",
            "expression": "COUNTROWS(SUMMARIZE(FactVentas, FactVentas[ClienteKey], FactVentas[FechaKey], FactVentas[CanalKey]))",
            "formatString": "#,0",
            "displayFolder": "6. Indicadores del caso\\Cesta",
            "description": "Cesta = mismo cliente + mismo día + mismo canal (no hay número de pedido)"
          },
          {
            "name": ".Ticket_Cesta",
            "expression": "DIVIDE([.Ventas], [.Cestas])",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Cesta",
            "description": "Ventas / cestas"
          },
          {
            "name": ".Articulos_por_Cesta",
            "expression": "DIVIDE([.Transacciones], [.Cestas])",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Cesta",
            "description": "Artículos (líneas) / cestas"
          },
          {
            "name": ".Precio_Lista",
            "expression": "SUM(FactVentas[PrecioLista])",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Precio"
          },
          {
            "name": ".%Descuento_Implicito",
            "expression": "IF([.Precio_Lista] > 0, 1 - DIVIDE([.Ventas], [.Precio_Lista]))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Precio",
            "description": "1 - precio cobrado / precio máximo observado del artículo"
          },
          {
            "name": ".%Lineas_Descuento_30",
            "expression": "DIVIDE(CALCULATE([.Transacciones], FactVentas[BandaDescuento] = \"4. Más de 30 %\"), [.Transacciones])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Precio",
            "description": "Líneas vendidas con más de 30 % de descuento"
          },
          {
            "name": ".Color_Descuento",
            "expression": "VAR x = [.%Descuento_Implicito]\nRETURN\n    SWITCH(TRUE(), ISBLANK(x), BLANK(), x <= 0.17, \"#1E8449\", x <= 0.17 + 0.02, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "6. Indicadores del caso\\Precio",
            "description": "Meta propuesta <= 17 %"
          },
          {
            "name": ".Delta_Interanual",
            "expression": "IF(ISBLANK([.Ventas_Mismo_Periodo_AA]), BLANK(), [.Ventas] - [.Ventas_Mismo_Periodo_AA])",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Crecimiento",
            "description": "Diferencia contra el mismo periodo del año anterior"
          },
          {
            "name": ".%Interanual_Tienda",
            "expression": "CALCULATE([.%Crecimiento_Interanual], DimCanal[NombreCanal] = \"Tienda fisica\")",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Crecimiento"
          },
          {
            "name": ".%Interanual_Online",
            "expression": "CALCULATE([.%Crecimiento_Interanual], DimCanal[NombreCanal] = \"Online\")",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Crecimiento"
          },
          {
            "name": ".Interanual_I",
            "expression": "VAR x = [.%Crecimiento_Interanual]\nRETURN\n    IF(ISBLANK(x), BLANK(), FORMAT(x, \"+0.0 %;-0.0 %\") & IF(x >= 0, \"  ▲\", \"  ▼\"))",
            "displayFolder": "6. Indicadores del caso\\Crecimiento"
          },
          {
            "name": ".Color_Interanual",
            "expression": "VAR x = [.%Crecimiento_Interanual]\nRETURN\n    SWITCH(TRUE(), ISBLANK(x), BLANK(), x >= 0, \"#1E8449\", x >= 0 - 0.05, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "6. Indicadores del caso\\Crecimiento",
            "description": "Meta propuesta >= 0 %"
          },
          {
            "name": ".Ventas_Acumuladas",
            "expression": "CALCULATE([.Ventas], FILTER(ALLSELECTED(DimFecha[Fecha]), DimFecha[Fecha] <= MAX(DimFecha[Fecha])))",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Crecimiento"
          },
          {
            "name": ".%Clientes_Omnicanal",
            "expression": "DIVIDE(CALCULATE([.Clientes_Unicos], DimCliente[TipoCanal] = \"Omnicanal\"), [.Clientes_Unicos])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Clientes"
          },
          {
            "name": ".%Penetracion_Club",
            "expression": "DIVIDE(CALCULATE([.Clientes_Unicos], DimCliente[ClubActivo] = \"Club activo\"), [.Clientes_Unicos])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Clientes"
          },
          {
            "name": ".%Ventas_Top20_Clientes",
            "expression": "DIVIDE(CALCULATE([.Ventas], DimCliente[SegmentoValor] = \"1. Top 20 %\"), [.Ventas])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Clientes"
          },
          {
            "name": ".Ventas_por_Cliente_Omnicanal",
            "expression": "CALCULATE([.Ventas_por_Cliente], DimCliente[TipoCanal] = \"Omnicanal\")",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Clientes"
          },
          {
            "name": ".Ventas_por_Cliente_UnCanal",
            "expression": "CALCULATE([.Ventas_por_Cliente], DimCliente[TipoCanal] IN {\"Solo online\", \"Solo tienda\"})",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Clientes"
          },
          {
            "name": ".Multiplicador_Omnicanal",
            "expression": "DIVIDE([.Ventas_por_Cliente_Omnicanal], [.Ventas_por_Cliente_UnCanal])",
            "formatString": "0.0\"x\"",
            "displayFolder": "6. Indicadores del caso\\Clientes",
            "description": "Cuántas veces más compra el cliente omnicanal"
          },
          {
            "name": ".%Plus_Club",
            "expression": "DIVIDE(CALCULATE([.Ventas_por_Cliente], DimCliente[ClubActivo] = \"Club activo\"),\n       CALCULATE([.Ventas_por_Cliente], DimCliente[ClubActivo] = \"No activo\")) - 1",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Clientes",
            "description": "Cuánto más compra el cliente con club activo"
          },
          {
            "name": ".Narrativa_Estrategica",
            "expression": "VAR y = [.%Crecimiento_Interanual]\nRETURN\n    IF(ISBLANK(y),\n       \"Todo el periodo: \" & FORMAT([.Ventas] / 1E9, \"#,0\") & \" MM vendidos y \" & FORMAT([.%Cumplimiento_Meta], \"0.0 %\")\n           & \" de la meta. Elige un año (y con cuál compararlo) para ver si crecemos.\",\n       \"En \" & [.Anio_Elegido] & \" llegamos al \" & FORMAT([.%Cumplimiento_Meta], \"0.0 %\") & \" de la meta y vendemos \"\n           & FORMAT(y, \"+0.0 %;-0.0 %\") & \" \" & [.Txt_Comparacion] & \" (tienda \"\n           & FORMAT([.%Interanual_Tienda], \"+0.0 %;-0.0 %\") & \", online \" & FORMAT([.%Interanual_Online], \"+0.0 %;-0.0 %\") & \").\")",
            "displayFolder": "6. Indicadores del caso\\Narrativa",
            "description": "Cambia con los filtros de año y Comparar con"
          },
          {
            "name": ".Narrativa_Cliente",
            "expression": "\"El cliente omnicanal compra \" & FORMAT([.Multiplicador_Omnicanal], \"0.0\") & \" veces más y el de club activo \"\n    & FORMAT([.%Plus_Club], \"+0 %\") & \"; el top 20 % genera el \" & FORMAT([.%Ventas_Top20_Clientes], \"0 %\")\n    & \" de la venta. Descuento implícito: \" & FORMAT([.%Descuento_Implicito], \"0.0 %\") & \".\"",
            "displayFolder": "6. Indicadores del caso\\Narrativa"
          },
          {
            "name": ".Ventas_MM",
            "expression": "DIVIDE([.Ventas], 1E9)",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Ventas en miles de millones"
          },
          {
            "name": ".Ventas_AA_MM",
            "expression": "DIVIDE([.Ventas_Mismo_Periodo_AA], 1E9)",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Año de comparación, mismos días, en MM"
          },
          {
            "name": ".Ventas_Online_AA",
            "expression": "VAR k = [.Desfase_Meses]\nVAR fechas = SELECTCOLUMNS(VALUES(DimFecha[Fecha]), \"F\", EDATE(DimFecha[Fecha], -k))\nRETURN\n    IF(NOT ISBLANK(k) && k <> 0, CALCULATE([.Ventas_Online], ALL(DimFecha), TREATAS(fechas, DimFecha[Fecha])))",
            "formatString": "#,0.00",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".%Ventas_Online_AA",
            "expression": "DIVIDE([.Ventas_Online_AA], [.Ventas_Mismo_Periodo_AA])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Online",
            "expression": "IF(ISBLANK([.%Ventas_Online_AA]), \"Elige un año para compararlo\", [.Txt_Comparacion] & \": \" & FORMAT([.%Ventas_Online_AA], \"0.0 %\"))",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Ventas",
            "expression": "IF(ISBLANK([.Interanual_I]), \"Elige un año para compararlo\", [.Interanual_I] & \" \" & [.Txt_Comparacion])",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Interanual_Tienda_I",
            "expression": "IF(ISBLANK([.%Interanual_Tienda]), \"—\", FORMAT([.%Interanual_Tienda], \"+0.0 %;-0.0 %\"))",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Interanual_Total_I",
            "expression": "IF(ISBLANK([.%Crecimiento_Interanual]), \"—\", FORMAT([.%Crecimiento_Interanual], \"+0.0 %;-0.0 %\"))",
            "displayFolder": "7. Dashboards",
            "description": "Crecimiento contra el año de comparacion; sin año elegido muestra un guion"
          },
          {
            "name": ".Ventas_AA_MM_Txt",
            "expression": "IF(ISBLANK([.Ventas_AA_MM]), \"Elige un año\", FORMAT([.Ventas_AA_MM], \"#,0\"))",
            "displayFolder": "7. Dashboards",
            "description": "Venta del mismo periodo del año de comparacion (MM); sin año elegido pide elegirlo"
          },
          {
            "name": ".Retencion_I",
            "expression": "IF(ISBLANK([.%Retencion]), \"Elige un año\", FORMAT([.%Retencion], \"0.0 %\"))",
            "displayFolder": "7. Dashboards",
            "description": "Retencion del año elegido; sin año elegido pide elegirlo"
          },
          {
            "name": ".Interanual_Online_I",
            "expression": "IF(ISBLANK([.%Interanual_Online]), \"—\", FORMAT([.%Interanual_Online], \"+0.0 %;-0.0 %\"))",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Ventas_por_Cliente_M",
            "expression": "DIVIDE([.Ventas_por_Cliente], 1E6)",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Venta por cliente en millones"
          },
          {
            "name": ".Color_Interanual_Tienda",
            "expression": "VAR x = [.%Interanual_Tienda]\nRETURN\n    SWITCH(TRUE(), ISBLANK(x), BLANK(), x >= 0, \"#1E8449\", x >= 0 - 0.1, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Interanual_Online",
            "expression": "VAR x = [.%Interanual_Online]\nRETURN\n    SWITCH(TRUE(), ISBLANK(x), BLANK(), x >= 0, \"#1E8449\", x >= 0 - 0.1, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Online",
            "expression": "VAR r = [.%Ventas_Online]\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Online_Resto",
            "expression": "IF(ISBLANK([.Anillo_Online]), BLANK(), 1 - [.Anillo_Online])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Online",
            "expression": "\"#2E6DA4\"",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Retencion_Anio",
            "expression": "IF(ISBLANK([.Anio_Elegido]), CALCULATE(MAX(DimFecha[Anio]), ALL(DimFecha)), [.Anio_Elegido])",
            "formatString": "0",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Retencion_Base",
            "expression": "IF(ISBLANK([.Anio_Elegido]), [.Retencion_Anio] - 1, [.Anio_Comparacion])",
            "formatString": "0",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".%Retencion",
            "expression": "VAR a = [.Retencion_Anio]\nVAR c = [.Retencion_Base]\nVAR antes = CALCULATETABLE(VALUES(FactVentas[ClienteKey]), ALL(DimFecha), DimFecha[Anio] = c)\nVAR despues = CALCULATETABLE(VALUES(FactVentas[ClienteKey]), ALL(DimFecha), DimFecha[Anio] = a)\nRETURN\n    IF(c < a, DIVIDE(COUNTROWS(INTERSECT(antes, despues)), COUNTROWS(antes)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards",
            "description": "Clientes que compraron en el año base y vuelven a comprar en el año elegido"
          },
          {
            "name": ".Anillo_Retencion",
            "expression": "VAR r = DIVIDE([.%Retencion], 0.65)\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Retencion_Resto",
            "expression": "IF(ISBLANK([.Anillo_Retencion]), BLANK(), 1 - [.Anillo_Retencion])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Retencion",
            "expression": "VAR r = DIVIDE([.%Retencion], 0.65)\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Retencion",
            "expression": "\"Meta ≥ 65 % · clientes de \" & [.Retencion_Base] & \" que vuelven en \" & [.Retencion_Anio]",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".%Descuento_Tienda",
            "expression": "CALCULATE([.%Descuento_Implicito], DimCanal[NombreCanal] = \"Tienda fisica\")",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".%Descuento_Tienda_AA",
            "expression": "VAR k = [.Desfase_Meses]\nVAR fechas = SELECTCOLUMNS(VALUES(DimFecha[Fecha]), \"F\", EDATE(DimFecha[Fecha], -k))\nRETURN\n    IF(NOT ISBLANK(k) && k <> 0, CALCULATE([.%Descuento_Tienda], ALL(DimFecha), TREATAS(fechas, DimFecha[Fecha])))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Descuento",
            "expression": "IF(ISBLANK([.%Descuento_Tienda_AA]), \"Meta ≤ 17 %\", \"Meta ≤ 17 % · \" & [.Txt_Comparacion] & \": \" & FORMAT([.%Descuento_Tienda_AA], \"0.0 %\"))",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Descuento",
            "expression": "VAR r = DIVIDE(0.17, [.%Descuento_Tienda])\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Descuento_Resto",
            "expression": "IF(ISBLANK([.Anillo_Descuento]), BLANK(), 1 - [.Anillo_Descuento])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Descuento",
            "expression": "VAR r = DIVIDE(0.17, [.%Descuento_Tienda])\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Ticket_Cesta_Online",
            "expression": "CALCULATE([.Ticket_Cesta], DimCanal[NombreCanal] = \"Online\")",
            "formatString": "#,0.00",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Ticket_Cesta_Online_M",
            "expression": "DIVIDE([.Ticket_Cesta_Online], 1E6)",
            "formatString": "#,0.0",
            "displayFolder": "7. Dashboards",
            "description": "Ticket por cesta online en millones"
          },
          {
            "name": ".Ticket_Cesta_Online_AA",
            "expression": "VAR k = [.Desfase_Meses]\nVAR fechas = SELECTCOLUMNS(VALUES(DimFecha[Fecha]), \"F\", EDATE(DimFecha[Fecha], -k))\nRETURN\n    IF(NOT ISBLANK(k) && k <> 0, CALCULATE([.Ticket_Cesta_Online], ALL(DimFecha), TREATAS(fechas, DimFecha[Fecha])))",
            "formatString": "#,0.00",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Ticket",
            "expression": "IF(ISBLANK([.Ticket_Cesta_Online_AA]), \"Elige un año para compararlo\", FORMAT(DIVIDE([.Ticket_Cesta_Online], [.Ticket_Cesta_Online_AA]) - 1, \"+0.0 %;-0.0 %\") & \" \" & [.Txt_Comparacion] & \" (\" & FORMAT([.Ticket_Cesta_Online_AA] / 1E6, \"#,0.0\") & \" M)\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Ticket",
            "expression": "VAR r = DIVIDE([.Ticket_Cesta_Online], [.Ticket_Cesta_Online_AA])\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Ticket_Resto",
            "expression": "IF(ISBLANK([.Anillo_Ticket]), BLANK(), 1 - [.Anillo_Ticket])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Ticket",
            "expression": "VAR r = DIVIDE([.Ticket_Cesta_Online], [.Ticket_Cesta_Online_AA])\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Articulos_Cesta_Online",
            "expression": "CALCULATE([.Articulos_por_Cesta], DimCanal[NombreCanal] = \"Online\")",
            "formatString": "#,0.00",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Articulos",
            "expression": "\"Meta propuesta ≥ 3,7\"",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Articulos",
            "expression": "VAR r = DIVIDE([.Articulos_Cesta_Online], 3.7)\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Articulos_Resto",
            "expression": "IF(ISBLANK([.Anillo_Articulos]), BLANK(), 1 - [.Anillo_Articulos])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Articulos",
            "expression": "VAR r = DIVIDE([.Articulos_Cesta_Online], 3.7)\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Omnicanal",
            "expression": "VAR r = DIVIDE([.%Clientes_Omnicanal], 0.40)\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Omnicanal_Resto",
            "expression": "IF(ISBLANK([.Anillo_Omnicanal]), BLANK(), 1 - [.Anillo_Omnicanal])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Omnicanal",
            "expression": "VAR r = DIVIDE([.%Clientes_Omnicanal], 0.40)\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Omnicanal",
            "expression": "\"Meta ≥ 40 % · valen \" & FORMAT([.Multiplicador_Omnicanal], \"0.0\") & \" veces más\"",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Club",
            "expression": "VAR r = DIVIDE([.%Penetracion_Club], 0.40)\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Club_Resto",
            "expression": "IF(ISBLANK([.Anillo_Club]), BLANK(), 1 - [.Anillo_Club])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Club",
            "expression": "VAR r = DIVIDE([.%Penetracion_Club], 0.40)\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Club",
            "expression": "\"Meta ≥ 40 % · compran \" & FORMAT([.%Plus_Club], \"+0 %\") & \" más\"",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".VPC_Omnicanal_M",
            "expression": "DIVIDE(CALCULATE([.Ventas_por_Cliente], DimCliente[TipoCanal] = \"Omnicanal\"), 1E6)",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Venta por cliente en millones"
          },
          {
            "name": ".VPC_UnCanal_M",
            "expression": "DIVIDE(CALCULATE([.Ventas_por_Cliente], DimCliente[TipoCanal] IN {\"Solo online\", \"Solo tienda\"}), 1E6)",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Venta por cliente en millones"
          },
          {
            "name": ".VPC_Club_M",
            "expression": "DIVIDE(CALCULATE([.Ventas_por_Cliente], DimCliente[ClubActivo] = \"Club activo\"), 1E6)",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Venta por cliente en millones"
          },
          {
            "name": ".VPC_NoClub_M",
            "expression": "DIVIDE(CALCULATE([.Ventas_por_Cliente], DimCliente[ClubActivo] = \"No activo\"), 1E6)",
            "formatString": "#,0",
            "displayFolder": "7. Dashboards",
            "description": "Venta por cliente en millones"
          },
          {
            "name": ".Multiplicador_Omnicanal_I",
            "expression": "\"× \" & FORMAT([.Multiplicador_Omnicanal], \"0.0\")",
            "displayFolder": "7. Dashboards"
          }
        ]
      },
      {
        "name": "FactMetas",
        "columns": [
          {
            "name": "Escenario",
            "dataType": "string",
            "sourceColumn": "Escenario"
          },
          {
            "name": "FechaKey",
            "dataType": "int64",
            "sourceColumn": "FechaKey",
            "isHidden": true
          },
          {
            "name": "DepartamentoKey",
            "dataType": "int64",
            "sourceColumn": "DepartamentoKey",
            "isHidden": true
          },
          {
            "name": "TemporadaKey",
            "dataType": "int64",
            "sourceColumn": "TemporadaKey",
            "isHidden": true
          },
          {
            "name": "Meta",
            "dataType": "double",
            "sourceColumn": "Meta",
            "isHidden": true,
            "formatString": "#,0.00",
            "description": "Monto de GoalsHyM.xlsx tal como viene: meta por escenario, seccion, temporada y mes"
          }
        ],
        "partitions": [
          {
            "name": "FactMetas",
            "dataView": "full",
            "source": {
              "query": "SELECT [Escenario], [FechaKey], [DepartamentoKey], [TemporadaKey], [Monto] AS [Meta]\n  FROM [Ventas].[FactMetas]",
              "dataSource": "DWH_HM"
            }
          }
        ],
        "measures": [
          {
            "name": ".Escenario_Activo",
            "expression": "SELECTEDVALUE(FactMetas[Escenario], \"Escenario 2\")",
            "displayFolder": "4. Metas",
            "description": "Escenario elegido en el segmentador; si no hay uno solo, se usa el Escenario 2 (meta oficial del caso)"
          },
          {
            "name": ".Meta",
            "expression": "VAR esc = [.Escenario_Activo]\nRETURN\n    CALCULATE(SUM(FactMetas[Meta]), FactMetas[Escenario] = esc)",
            "formatString": "#,0.00",
            "displayFolder": "4. Metas"
          },
          {
            "name": ".%Cumplimiento_Meta",
            "expression": "DIVIDE([.Ventas], [.Meta])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "4. Metas"
          },
          {
            "name": ".Brecha_Meta",
            "expression": "IF(ISBLANK([.Meta]), BLANK(), [.Ventas] - [.Meta])",
            "formatString": "#,0.00",
            "displayFolder": "4. Metas"
          },
          {
            "name": ".Cumplimiento_I",
            "expression": "VAR c = [.%Cumplimiento_Meta]\nRETURN\n    IF(ISBLANK(c), BLANK(), FORMAT(c, \"0.0 %\") & IF(c >= 1, \"  ▲\", \"  ▼\"))",
            "displayFolder": "4. Metas"
          },
          {
            "name": ".Color_Cumplimiento",
            "expression": "VAR c = [.%Cumplimiento_Meta]\nRETURN\n    SWITCH(TRUE(), ISBLANK(c), BLANK(), c >= 1, \"#1E8449\", c >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "4. Metas",
            "description": "Verde >= 100 %, ámbar >= 90 %, rojo < 90 % (formato condicional por valor de campo)"
          },
          {
            "name": ".Titulo_Ventas_vs_Meta",
            "expression": "\"Ventas vs meta - \" & [.Escenario_Activo]",
            "displayFolder": "4. Metas"
          },
          {
            "name": ".Meta_Acumulada",
            "expression": "CALCULATE([.Meta], FILTER(ALLSELECTED(DimFecha[Fecha]), DimFecha[Fecha] <= MAX(DimFecha[Fecha])))",
            "formatString": "#,0.00",
            "displayFolder": "6. Indicadores del caso\\Metas"
          },
          {
            "name": ".Secciones_con_Meta",
            "expression": "COUNTROWS(FILTER(VALUES(DimDepartamento[Seccion]), NOT ISBLANK([.Meta])))",
            "formatString": "#,0",
            "displayFolder": "6. Indicadores del caso\\Metas"
          },
          {
            "name": ".Secciones_Cumplen",
            "expression": "COUNTROWS(FILTER(VALUES(DimDepartamento[Seccion]), [.%Cumplimiento_Meta] >= 1))",
            "formatString": "#,0",
            "displayFolder": "6. Indicadores del caso\\Metas"
          },
          {
            "name": ".Secciones_Bajo_50",
            "expression": "COUNTROWS(FILTER(VALUES(DimDepartamento[Seccion]), NOT ISBLANK([.Meta]) && [.%Cumplimiento_Meta] < 0.5))",
            "formatString": "#,0",
            "displayFolder": "6. Indicadores del caso\\Metas"
          },
          {
            "name": ".Cumplimiento_Top5",
            "expression": "VAR r = RANKX(FILTER(ALLSELECTED(DimDepartamento[Seccion]), NOT ISBLANK([.Meta])), [.%Cumplimiento_Meta], , DESC)\nRETURN\n    IF(HASONEVALUE(DimDepartamento[Seccion]) && NOT ISBLANK([.Meta]) && r <= 5, [.%Cumplimiento_Meta])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Metas"
          },
          {
            "name": ".Cumplimiento_Bottom5",
            "expression": "VAR r = RANKX(FILTER(ALLSELECTED(DimDepartamento[Seccion]), NOT ISBLANK([.Meta])), [.%Cumplimiento_Meta], , ASC)\nRETURN\n    IF(HASONEVALUE(DimDepartamento[Seccion]) && NOT ISBLANK([.Meta]) && r <= 5, [.%Cumplimiento_Meta])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "6. Indicadores del caso\\Metas"
          },
          {
            "name": ".Narrativa_Metas",
            "expression": "\"Llegamos al \" & FORMAT([.%Cumplimiento_Meta], \"0 %\") & \" de la meta, pero solo \" & [.Secciones_Cumplen] & \" de \"\n    & [.Secciones_con_Meta] & \" secciones cumplen y \" & [.Secciones_Bajo_50] & \" no llegan al 50 %: metas mal repartidas.\"",
            "displayFolder": "6. Indicadores del caso\\Narrativa"
          },
          {
            "name": ".Meta_AA",
            "expression": "VAR k = [.Desfase_Meses]\nVAR fechas = SELECTCOLUMNS(VALUES(DimFecha[Fecha]), \"F\", EDATE(DimFecha[Fecha], -k))\nRETURN\n    IF(NOT ISBLANK(k) && k <> 0, CALCULATE([.Meta], ALL(DimFecha), TREATAS(fechas, DimFecha[Fecha])))",
            "formatString": "#,0.00",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".%Cumplimiento_AA",
            "expression": "DIVIDE([.Ventas_Mismo_Periodo_AA], [.Meta_AA])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Cumplimiento",
            "expression": "IF(ISBLANK([.%Cumplimiento_AA]), \"Meta ≥ 100 %\", \"Meta ≥ 100 % · \" & [.Txt_Comparacion] & \": \" & FORMAT([.%Cumplimiento_AA], \"0.0 %\"))",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Cumplimiento",
            "expression": "VAR r = [.%Cumplimiento_Meta]\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Cumplimiento_Resto",
            "expression": "IF(ISBLANK([.Anillo_Cumplimiento]), BLANK(), 1 - [.Anillo_Cumplimiento])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Cumplimiento",
            "expression": "VAR r = [.%Cumplimiento_Meta]\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Cumpl_Peor_Temporada",
            "expression": "MINX(FILTER(VALUES(DimTemporada[Temporada]), NOT ISBLANK([.Meta])), [.%Cumplimiento_Meta])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Peor_Temporada",
            "expression": "VAR t = TOPN(1, FILTER(VALUES(DimTemporada[Temporada]), NOT ISBLANK([.Meta])), [.%Cumplimiento_Meta], ASC)\nRETURN CONCATENATEX(t, DimTemporada[Temporada], \", \")",
            "displayFolder": "7. Dashboards",
            "description": "Temporada con menor cumplimiento en el filtro"
          },
          {
            "name": ".Anillo_Peor_Temporada",
            "expression": "VAR r = [.Cumpl_Peor_Temporada]\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Peor_Temporada_Resto",
            "expression": "IF(ISBLANK([.Anillo_Peor_Temporada]), BLANK(), 1 - [.Anillo_Peor_Temporada])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Peor_Temporada",
            "expression": "VAR r = [.Cumpl_Peor_Temporada]\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Secciones_Cumplen_Txt",
            "expression": "(0 + [.Secciones_Cumplen]) & \" de \" & (0 + [.Secciones_con_Meta])",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Secciones_Bajo_50_Txt",
            "expression": "(0 + [.Secciones_Bajo_50]) & \" de \" & (0 + [.Secciones_con_Meta])",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Secciones",
            "expression": "FORMAT(DIVIDE([.Secciones_Cumplen], [.Secciones_con_Meta]), \"0 %\") & \" de las secciones con meta\"",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Det_Bajo_50",
            "expression": "\"No llegan a la mitad de su meta\"",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Secciones",
            "expression": "VAR r = DIVIDE([.Secciones_Cumplen], [.Secciones_con_Meta])\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Secciones_Resto",
            "expression": "IF(ISBLANK([.Anillo_Secciones]), BLANK(), 1 - [.Anillo_Secciones])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Secciones",
            "expression": "VAR r = DIVIDE([.Secciones_Cumplen], [.Secciones_con_Meta])\nRETURN SWITCH(TRUE(), ISBLANK(r), BLANK(), r >= 1, \"#1E8449\", r >= 0.9, \"#B9770E\", \"#B03A2E\")",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Bajo_50",
            "expression": "VAR r = DIVIDE([.Secciones_Bajo_50], [.Secciones_con_Meta])\nRETURN IF(ISBLANK(r), BLANK(), MAX(0, MIN(r, 1)))",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Anillo_Bajo_50_Resto",
            "expression": "IF(ISBLANK([.Anillo_Bajo_50]), BLANK(), 1 - [.Anillo_Bajo_50])",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Color_Anillo_Bajo_50",
            "expression": "\"#B03A2E\"",
            "displayFolder": "7. Dashboards"
          },
          {
            "name": ".Gauge_Max",
            "expression": "1.5",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards",
            "description": "Escala del velocímetro (0 a 150 %)"
          },
          {
            "name": ".Gauge_Meta",
            "expression": "1",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards",
            "description": "Meta del velocímetro (100 %)"
          },
          {
            "name": ".Gauge_Uno",
            "expression": "1",
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "7. Dashboards",
            "description": "Escala de los anillos de los KPI (0 a 100 %)"
          }
        ]
      },
      {
        "name": "AnioComparacion",
        "description": "Años disponibles para el filtro Comparar con (sale de DimFecha: crece solo con los datos)",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Comparar con",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Comparar con]",
            "formatString": "0",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "AnioComparacion",
            "source": {
              "type": "calculated",
              "expression": "DISTINCT(SELECTCOLUMNS(DimFecha, \"Comparar con\", DimFecha[Anio]))"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "FV_Fecha",
        "fromTable": "FactVentas",
        "fromColumn": "FechaKey",
        "toTable": "DimFecha",
        "toColumn": "FechaKey"
      },
      {
        "name": "FV_Cliente",
        "fromTable": "FactVentas",
        "fromColumn": "ClienteKey",
        "toTable": "DimCliente",
        "toColumn": "ClienteKey"
      },
      {
        "name": "FV_Articulo",
        "fromTable": "FactVentas",
        "fromColumn": "ArticuloKey",
        "toTable": "DimArticulo",
        "toColumn": "ArticuloKey"
      },
      {
        "name": "FV_Departamento",
        "fromTable": "FactVentas",
        "fromColumn": "DepartamentoKey",
        "toTable": "DimDepartamento",
        "toColumn": "DepartamentoKey"
      },
      {
        "name": "FV_Canal",
        "fromTable": "FactVentas",
        "fromColumn": "CanalKey",
        "toTable": "DimCanal",
        "toColumn": "CanalKey"
